---
import BaseLayout from '../layouts/BaseLayout.astro';

const contacts = [
  {
    href: 'mailto:galih.saputra@gmail.com',
    icon: 'fa-solid fa-envelope',
    label: 'Email',
    value: 'galih.saputra@gmail.com',
  },
  {
    href: 'https://github.com/Galih17421010',
    icon: 'fa-brands fa-github',
    label: 'GitHub',
    value: '@Galih17421010',
  },
  {
    href: 'https://linkedin.com/in/galih-agus-saputra',
    icon: 'fa-brands fa-linkedin-in',
    label: 'LinkedIn',
    value: 'galih-agus-saputra',
  },
];
---

<BaseLayout
  title="Contact - Galih Agus Saputra"
  description="Hubungi saya untuk kolaborasi, diskusi proyek, atau kesempatan kerja."
>
  <div class="page-hero container">
    <p class="breadcrumb"><a href="/">Home</a> / Contact</p>
    <h1>Mari Berkolaborasi</h1>
    <p>
      Saya selalu terbuka untuk mendiskusikan proyek baru, ide kreatif, atau kesempatan berkolaborasi.
    </p>
  </div>

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info fade-in">
          <p>
            Jangan ragu untuk menghubungi saya melalui salah satu platform di bawah, atau
            kirim pesan langsung melalui form di samping.
          </p>
          <div class="contact-list">
            {contacts.map((c) => (
              <a href={c.href} target="_blank" rel="noopener noreferrer">
                <i class={c.icon} aria-hidden="true"></i>
                <div>
                  {c.label}
                  <small>{c.value}</small>
                </div>
              </a>
            ))}
          </div>
        </div>

        <form class="contact-form fade-in" method="POST" action="/contact/">
          <div class="form-group">
            <label for="name">Nama</label>
            <input type="text" id="name" name="name" placeholder="Nama lengkap" required />
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="email@example.com" required />
          </div>
          <div class="form-group">
            <label for="subject">Subjek</label>
            <input type="text" id="subject" name="subject" placeholder="Subjek pesan" required />
          </div>
          <div class="form-group">
            <label for="message">Pesan</label>
            <textarea id="message" name="message" rows="6" placeholder="Tulis pesan Anda di sini..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
            Kirim Pesan
          </button>
          <p class="form-note">
            Situs ini statis (GitHub Pages). Form akan membuka email client Anda dengan pesan yang sudah diisi.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector('.contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const subject = encodeURIComponent(data.get('subject') || 'Pesan dari portfolio');
    const body = encodeURIComponent(
      `Halo Galih,\n\n${data.get('message')}\n\n- ${data.get('name')} (${data.get('email')})`
    );
    window.location.href = `mailto:galih.saputra@gmail.com?subject=${subject}&body=${body}`;
  });
</script>
