---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Halaman Tidak Ditemukan" description="404 - Halaman tidak ditemukan.">
  <section class="section">
    <div class="container text-center">
      <h1 style="font-size: 6rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1;">
        404
      </h1>
      <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 28px;">
        Halaman yang Anda cari tidak ditemukan.
      </p>
      <a href="/" class="btn btn-primary">
        <i class="fa-solid fa-house" aria-hidden="true"></i>
        Kembali ke Beranda
      </a>
    </div>
  </section>
</BaseLayout>
