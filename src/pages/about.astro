---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const [about] = await getCollection('about');
const { Content } = await render(about);
---

<BaseLayout
  title={`Tentang Saya - ${about.data.name}`}
  description={about.data.bio}
>
  <div class="page-hero container">
    <p class="breadcrumb"><a href="/">Home</a> / Tentang Saya</p>
    <h1>Tentang Saya</h1>
    <p>{about.data.bio}</p>
  </div>

  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div class="profile-image">
          <div class="avatar-frame" aria-hidden="true">
            <i class="fa-solid fa-user-astronaut"></i>
          </div>
        </div>
        <div>
          <article class="prose">
            <Content />
          </article>
          <div class="about-info" style="margin-top: 32px;">
            <div class="info-item">
              <i class="fa-solid fa-user" aria-hidden="true"></i>
              <div>
                <strong>Nama</strong>
                <span>{about.data.name}</span>
              </div>
            </div>
            <div class="info-item">
              <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
              <div>
                <strong>Role</strong>
                <span>{about.data.role}</span>
              </div>
            </div>
            <div class="info-item">
              <i class="fa-solid fa-award" aria-hidden="true"></i>
              <div>
                <strong>Pengalaman</strong>
                <span>{about.data.experienceYears}+ tahun</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
