---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/format';

const [about] = await getCollection('about');
const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={`${about.data.name} - Software Developer`}
  description={about.data.bio}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="fade-in">
          <span class="hero-badge">
            <span class="status-dot" aria-hidden="true"></span>
            Tersedia untuk kolaborasi
          </span>
          <h1>
            {about.data.heroTagline.split('Galih')[0]}
            <span class="accent-text">Galih Agus Saputra</span>
          </h1>
          <p class="hero-subtitle">{about.data.heroSubtitle}</p>
          <div class="hero-actions">
            <a href="/projects/" class="btn btn-primary">Lihat Portfolio</a>
            <a href="/contact/" class="btn btn-outline">Hubungi Saya</a>
          </div>
          <div class="hero-stats">
            <div class="hero-stat">
              <div class="stat-value">{about.data.experienceYears}+</div>
              <div class="stat-label">Tahun Pengalaman</div>
            </div>
            <div class="hero-stat">
              <div class="stat-value">{projects.length}+</div>
              <div class="stat-label">Proyek Featured</div>
            </div>
            <div class="hero-stat">
              <div class="stat-value">{skills.length}+</div>
              <div class="stat-label">Teknologi</div>
            </div>
          </div>
        </div>
        <div class="hero-visual fade-in">
          <div class="avatar-frame" aria-hidden="true">
            <i class="fa-solid fa-user-astronaut"></i>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About preview -->
  <section class="section">
    <div class="container">
      <div class="section-head fade-in">
        <p class="section-eyebrow">Tentang Saya</p>
        <h2 class="section-title">Software Developer yang fokus pada solusi</h2>
      </div>
      <div class="about-grid">
        <div class="about-text fade-in">
          <p>{about.data.bio}</p>
          <a href="/about/" class="btn btn-ghost">
            Baca selengkapnya <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
        <div class="about-info fade-in">
          <div class="info-item">
            <i class="fa-solid fa-user" aria-hidden="true"></i>
            <div>
              <strong>Nama</strong>
              <span>{about.data.name}</span>
            </div>
          </div>
          <div class="info-item">
            <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
            <div>
              <strong>Role</strong>
              <span>{about.data.role}</span>
            </div>
          </div>
          <div class="info-item">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            <div>
              <strong>Lokasi</strong>
              <span>Indonesia</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section section-muted">
    <div class="container">
      <div class="section-head fade-in">
        <p class="section-eyebrow">Keahlian</p>
        <h2 class="section-title">Skills & Technologies</h2>
        <p class="section-desc">
          Teknologi yang saya gunakan untuk membangun produk digital yang solid.
        </p>
      </div>
      <div class="skills-grid">
        {skills.map((skill, i) => (
          <article class="skill-card fade-in">
            <span class="skill-category">{skill.data.category}</span>
            <i class={skill.data.icon} style={`color: ${skill.data.color}`} aria-hidden="true"></i>
            <h3>{skill.data.title}</h3>
            <p>{skill.data.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="section">
    <div class="container">
      <div class="section-head fade-in">
        <p class="section-eyebrow">Portfolio</p>
        <h2 class="section-title">Featured Projects</h2>
        <p class="section-desc">Beberapa proyek unggulan yang pernah saya kerjakan.</p>
      </div>
      <div class="projects-grid">
        {projects.map((project) => (
          <article class="project-card fade-in">
            <div class="project-icon" aria-hidden="true">
              <i class={project.data.icon}></i>
            </div>
            <div class="project-body">
              <h3>{project.data.title}</h3>
              <span class="project-date">{formatDate(project.data.pubDate)}</span>
              <p>{project.data.description}</p>
              <div class="tag-list">
                {project.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
              <div class="project-links">
                {
                  project.data.liveUrl && (
                    <a
                      href={project.data.liveUrl}
                      class="link-btn"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                      Live Demo
                    </a>
                  )
                }
                {
                  project.data.githubUrl && (
                    <a
                      href={project.data.githubUrl}
                      class="link-btn"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <i class="fa-brands fa-github" aria-hidden="true"></i>
                      GitHub
                    </a>
                  )
                }
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="text-center mt-16 fade-in">
        <a href="/projects/" class="btn btn-outline">Lihat Semua Proyek</a>
      </p>
    </div>
  </section>

  <!-- Blog preview -->
  <section class="section section-muted">
    <div class="container">
      <div class="section-head fade-in">
        <p class="section-eyebrow">Blog</p>
        <h2 class="section-title">Tulisan Terbaru</h2>
      </div>
      <div class="posts-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="post-card fade-in">
            <span class="post-date">{formatDate(post.data.pubDate)}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="post-read-more">
              Baca selengkapnya
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
