---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/format';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog - Galih Agus Saputra"
  description="Tulisan tentang pengembangan web, teknologi, dan pengalaman."
>
  <div class="page-hero container">
    <p class="breadcrumb"><a href="/">Home</a> / Blog</p>
    <h1>Blog</h1>
    <p>Tulisan tentang pengembangan web, teknologi, dan pengalaman. Semua konten ditulis dalam format MDX.</p>
  </div>

  <section class="section">
    <div class="container">
      {
        posts.length === 0 ? (
          <div class="empty-state">
            <p>Belum ada tulisan. Tambahkan file <code>.mdx</code> di <code>src/content/posts/</code>.</p>
          </div>
        ) : (
          <div class="posts-grid">
            {posts.map((post) => (
              <a href={`/blog/${post.slug}/`} class="post-card fade-in">
                <span class="post-date">{formatDate(post.data.pubDate)}</span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <div class="tag-list" style="margin-top: 12px;">
                  {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>
                <span class="post-read-more">
                  Baca selengkapnya
                  <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </span>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
